dient-to-r from-transparent via-white/80 to-transparent pointer-events-none animate-shimmer-sweep\" />\n\n                                                    {status === 'recording' ? (\n                                                        <div className=\"size-6 rounded-md bg-white shadow-md flex items-center justify-center animate-[zoom-in-50_0.2s_ease-out]\">\n                                                            <div className=\"size-2.5 bg-rose-600 rounded-sm\" />\n                                                        </div>\n                                                    ) : (\n                                                        <div className=\"relative z-10 transition-all duration-300 ease-in-out flex items-center justify-center\">\n                                                            <Mic size={30} strokeWidth={1.5} className={cn(\n                                                                \"transition-colors duration-300 relative z-10\",\n                                                                audioBlob ? \"text-emerald-500\" : \"text-indigo-500/70 dark:text-slate-400 group-hover/mic-btn:text-indigo-600 group-hover/mic-btn:scale-105\"\n                                                            )} />\n                                                        </div>\n                                                    )}\n                                                </button>\n\n                                                {audioBlob && (\n                                                    <div className=\"absolute -top-1.5 -right-1.5 size-8 rounded-full bg-emerald-500 text-white flex items-center justify-center border-2 border-white dark:border-slate-900 shadow-xl animate-in zoom-in-50 duration-500 z-20\">\n                                                        <Check size={16} strokeWidth={3} />\n                                                    </div>\n                                                )}\n   